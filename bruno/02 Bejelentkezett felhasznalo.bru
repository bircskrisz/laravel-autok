get {
  url: {{baseUrl}}/user
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("HTTP 200", function () {
    expect(res.status).to.equal(200);
    expect(res.body.email).to.equal("admin@example.com");
  });
}
