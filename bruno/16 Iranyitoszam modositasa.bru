meta {
  name: Iranyitoszam modositasa
  type: http
  seq: 16
}

put {
  url: {{baseUrl}}/postal-codes/{{postalCodeId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "postal_code": "2465",
    "city": "Ráckeresztúr (mód.)",
    "county_id": {{countyId}}
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.city).to.equal("Ráckeresztúr (mód.)");
  });
}
