meta {
  name: Kereses telepulesre
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/postal-codes?search=debr
  body: none
  auth: none
}

script:post-response {
  bru.setEnvVar("postalCodeId", res.body.data[0].id);
}

tests {
  test("HTTP 200", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.every(p => p.city === "Debrecen")).to.be.true;
  });
}
