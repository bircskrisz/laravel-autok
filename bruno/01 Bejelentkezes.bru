meta {
  name: Bejelentkezes
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@example.com",
    "password": "password"
  }
}

script:post-response {
  bru.setEnvVar("token", res.body.token);
}

tests {
  test("HTTP 200", function () {
    expect(res.status).to.equal(200);
    expect(res.body.token).to.be.a("string");
  });
}
