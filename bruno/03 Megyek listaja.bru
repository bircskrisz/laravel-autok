meta {
  name: Megyek listaja
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/counties
  body: none
  auth: none
}

script:post-response {
  const fejer = res.body.data.find(c => c.name === "Fejér");
  bru.setEnvVar("countyId", fejer.id);
}

tests {
  test("HTTP 200", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.length).to.equal(20);
  });
}
