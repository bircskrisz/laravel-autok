meta {
  name: Szures megyenevre
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/postal-codes?county=Pest&per_page=100
  body: none
  auth: none
}

tests {
  test("HTTP 200", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.every(p => p.county.name === "Pest")).to.be.true;
  });
}
